# Copy to .env for local development. Never commit .env.
# Long random secret; generate with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_TOKEN=change-me

# Denník N subscription session cookie (the whole Cookie header value from your browser).
# Optional: without it, Denník N search works but fetch returns paywalled teasers only.
DENNIKN_COOKIE=

# Identifies the client to the sites we query (email or URL).
USER_AGENT_CONTACT=

# Where SQLite + downloaded documents live (Docker: /data volume).
DATA_DIR=./data

# Optional tuning
RATE_LIMIT_PER_HOST=1.0
REQUEST_TIMEOUT=15
LOG_LEVEL=INFO
